{
  "name": "ai-tiny-codes",
  "version": "1.0.0",
  "private": true,
  "description": "这里面存一些 AI 帮我写的小段代码，啥都可能有",
  "scripts": {
    "fitness:calculate": "pnpm --filter @ai-tiny-codes/fitness calculate",
    "fitness:checkin": "pnpm --filter @ai-tiny-codes/fitness checkin",
    "fitness:sync": "pnpm --filter @ai-tiny-codes/fitness sync",
    "fitness:dashboard": "pnpm --filter @ai-tiny-codes/fitness dashboard",
    "fitness:update": "pnpm fitness:sync && pnpm fitness:dashboard",
    "money:calculate": "pnpm --filter @ai-tiny-codes/money calculate",
    "commute:compare": "pnpm --filter @ai-tiny-codes/commute compare",
    "keepstrong:probe": "pnpm --filter @ai-tiny-codes/keepstrong probe",
    "calendar:dev": "pnpm --filter @ai-tiny-codes/calendar dev",
    "calendar:build": "pnpm --filter @ai-tiny-codes/calendar build",
    "calendar:preview": "pnpm --filter @ai-tiny-codes/calendar preview",
    "calendar:test": "pnpm --filter @ai-tiny-codes/calendar test",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": [
    "ai-tiny-codes"
  ],
  "author": "kimimi_king@163.com",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@inquirer/prompts": "^8.7.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
